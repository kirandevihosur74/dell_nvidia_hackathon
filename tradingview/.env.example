# Copy this file to .env and fill in your own credentials.

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Polygon.io API key (https://polygon.io/dashboard/api-keys)
POLYGON_API_KEY=

# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster/db)
MONGODB_URI=

# --- Email-deliverable stock report (/report) -------------------------------
# Public base URL used for the "View full report in browser" links in the email.
REPORT_BASE_URL=http://127.0.0.1:5000

# SMTP for sending the report. For Gmail use an App Password (not your login).
# Port 587 = STARTTLS (set SMTP_TLS=true); port 465 = implicit SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional model overrides for the report narrative / citations.
# REPORT_MODEL=gpt-4o
# REPORT_SEARCH_MODEL=gpt-4o-mini-search-preview

# --- Inference backend (text chat / grounded analyze_assets) ----------------
# Default provider when a request doesn't specify one. The mobile app's
# "Inference Backend" toggle overrides this per request via the
# X-LLM-Provider header (local | openrouter | openai).
#   local      -> GB10 / local Ollama (default)
#   openrouter -> OpenRouter-hosted Nemotron mirror
#   openai     -> OpenAI cloud
LLM_PROVIDER=local

# GB10 / local Ollama (OpenAI-compatible). For a remote GB10, use its LAN IP.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
LOCAL_TEXT_MODEL=hf.co/unsloth/Nemotron-3-Nano-30B-A3B-GGUF:Q8_0
# USE_LOCAL_LLM=true        # legacy switch; LLM_PROVIDER takes precedence

# OpenRouter — the cloud mirror of the GB10 model. Get a key at
# https://openrouter.ai/keys . Default model mirrors the GB10's Nemotron.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b
# OPENROUTER_REFERER=https://github.com/kirandevihosur74/dell_nvidia_hackathon
# OPENROUTER_TITLE=OpenBell

# FRED economic data for macro intents (https://fredaccount.stlouisfed.org/apikeys)
FRED_API_KEY=
